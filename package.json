{
  "name": "actionparse",
  "version": "0.1.1",
  "description": "Parse FormData into typed, nested objects and validate them with any Standard Schema validator (Zod, Valibot, ArkType). Built for React 19 form actions and useActionState.",
  "type": "module",
  "license": "MIT",
  "author": "Murat Yılmaz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yilmazmurad/actionparse.git"
  },
  "homepage": "https://github.com/yilmazmurad/actionparse#readme",
  "bugs": "https://github.com/yilmazmurad/actionparse/issues",
  "keywords": [
    "formdata",
    "react",
    "react-19",
    "useActionState",
    "server-actions",
    "form-actions",
    "standard-schema",
    "zod",
    "valibot",
    "arktype",
    "validation"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "README.tr.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "valibot": "^1.5.0",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  }
}
